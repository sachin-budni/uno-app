# ---------------------------------------------------------------------------
# UNO Arena - environment configuration
# Copy to .env and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Node API (Express + Socket.IO)
PORT=3000
NODE_ENV=development

# JSON Server (persistence layer behind the Node API)
JSON_SERVER_URL=http://127.0.0.1:3001

# Auth
JWT_SECRET=change-this-secret-to-a-long-random-string
JWT_EXPIRES_IN=2h

# CORS / client origin (comma separated list allowed)
CLIENT_URL=http://localhost:4200

# Gameplay tuning
TURN_TIMEOUT_SECONDS=30
MAX_PLAYERS=4
INITIAL_HAND_SIZE=7
RECONNECT_GRACE_SECONDS=60

# Rule toggles. The defaults follow the published UNO rules.
# Stacking (+2 on +2) is a house rule, not an official one.
ALLOW_DRAW_STACKING=false
# challenge = official (bluffing allowed, the next player may challenge)
# restricted = server refuses an illegal +4 instead
WILD_DRAW_FOUR_MODE=challenge
TWO_PLAYER_REVERSE_ACTS_AS_SKIP=true
UNO_PENALTY_CARDS=2
# Official UNO only punishes a missed UNO when another player catches it.
# Set true for an automatic penalty instead (a house rule).
UNO_AUTO_PENALTY=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
